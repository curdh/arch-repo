_pkgname=openttd-jgrpp
pkgname=openttd-jgrpp-bin
pkgver=0.73.3
pkgrel=1
pkgdesc="Engine for running Transport Tycoon Deluxe with JGR's patch pack"
arch=(x86_64)
url=https://github.com/JGRennison/OpenTTD-patches
license=('GPL-2.0-only')
_release="openttd-jgrpp-${pkgver}-linux-generic-amd64"
depends=(
    'fluidsynth'
    'fontconfig'
    'hicolor-icon-theme'
    'lzo'
    'sdl2-compat'
)
optdepends=(
    'openttd-jgrpp-opengfx: free graphics'
    'openttd-jgrpp-opensfx: free sound set'
    'openttd-jgrpp-openmsx: free music set'
)
provides=('openttd-jgrpp')
conflicts=(
    'openttd-jgrpp'
    'openttd'
)
source=(
    "${_release}.tar.xz::https://github.com/JGRennison/OpenTTD-patches/releases/download/jgrpp-${pkgver}/${_release}.tar.xz"
    "openttd.sh"
)
sha256sums=('525ac6d22be4bf302f56711e07522df03cf02425d50ad1baf6b5ed4944561163'
            '623e3cbe3c8786fbeef119ffdd22fa660cf1fdd9f8a21ba54c0da4d3db8f6b7a')

package() {
    install -Dm755 "openttd.sh" "${pkgdir}/usr/bin/openttd"
    chmod 755 "${pkgdir}/usr/bin/openttd"

    cd "${srcdir}/${_release}"

    install -dm755 "${pkgdir}/usr/lib/${_pkgname}"
    cp -dr --no-preserve=ownership * "${pkgdir}/usr/lib/${_pkgname}/"

    if [ -d "${pkgdir}/usr/lib/${_pkgname}/share" ]; then
        install -dm755 "${pkgdir}/usr/share"
        cp -dr --no-preserve=ownership "${pkgdir}/usr/lib/${_pkgname}/share/"* "${pkgdir}/usr/share/"
        rm -rf "${pkgdir}/usr/lib/${_pkgname}/share"
    fi
}

